{
  "exercises": [
    {
      "id": 1,
      "name": "Plank",
      "description": "Body alignment hold in push-up position",
      "camera_angle": "side",
      "target_angle_range": 0,
      "primary_joints": ["shoulder", "hip", "ankle"],
      "generic_rules": {
        "angle_rules": [
          { "joint_a": "shoulder", "joint_b": "hip", "joint_c": "knee", "min_angle": 160, "max_angle": 200, "error_flag": "misaligned_body" }
        ],
        "alignment_rules": [
          { "joint_a": "shoulder", "joint_b": "hip", "max_diff": 0.15, "axis": "y", "error_flag": "misaligned_body" }
        ],
        "relative_rules": [
          { "joint": "hip", "reference": "shoulder", "operator": ">", "offset": 0.1, "axis": "y", "error_flag": "sagging_hips" }
        ]
      },
      "expected_accuracy": 0.88,
      "flags": {
        "misaligned_body": "Body not straight. Check alignment < 15°",
        "sagging_hips": "Hips sagging. Raise hips to shoulder level",
        "qbent_elbows": "Elbows bent. Keep arms straight > 160°",
        "head_position": "Head position incorrect. Keep neutral"
      }
    },
    {
      "id": 2,
      "name": "Wall Sit",
      "description": "Back against wall, knees bent at 90 degrees",
      "camera_angle": "front_or_side",
      "target_angle_range": [85, 95],
      "primary_joints": ["hip", "knee", "ankle"],
      "generic_rules": {
        "angle_rules": [
          { "joint_a": "hip", "joint_b": "knee", "joint_c": "ankle", "min_angle": 80, "max_angle": 100, "error_flag": "knee_angle_incorrect" },
          { "joint_a": "shoulder", "joint_b": "hip", "joint_c": "knee", "min_angle": 80, "max_angle": 100, "error_flag": "back_tilted" }
        ],
        "alignment_rules": [],
        "relative_rules": []
      },
      "expected_accuracy": 0.90,
      "flags": {
        "knee_angle_incorrect": "Knee angle incorrect. Target 85-95°",
        "back_tilted": "Back not vertical. Keep back against wall",
        "knees_over_toes": "Knees tracking over toes",
        "hips_too_high": "Hips too high. Lower down more"
      }
    },
    {
      "id": 3,
      "name": "Static Squat Hold",
      "description": "Squat position held at bottom range",
      "camera_angle": "front_or_side",
      "target_angle_range": [80, 100],
      "primary_joints": ["hip", "knee", "ankle"],
      "generic_rules": {
        "angle_rules": [
          { "joint_a": "hip", "joint_b": "knee", "joint_c": "ankle", "min_angle": 75, "max_angle": 105, "error_flag": "knee_angle_incorrect" }
        ],
        "alignment_rules": [],
        "relative_rules": [
          { "joint": "hip", "reference": "knee", "operator": "<", "offset": -0.05, "axis": "y", "error_flag": "hips_too_high" }
        ]
      },
      "expected_accuracy": 0.87,
      "flags": {
        "knee_angle_incorrect": "Knee angle out of range. Target 80-100°",
        "torso_tilted": "Torso tilted forward. Keep upright",
        "heels_off_ground": "Heels lifting off ground",
        "knees_caving_inward": "Knees caving inward. Keep alignment"
      }
    },
    {
      "id": 4,
      "name": "Glute Bridge Hold",
      "description": "Lying on back, hips elevated, knees bent",
      "camera_angle": "side",
      "target_angle_range": 160,
      "primary_joints": ["shoulder", "hip", "knee"],
      "generic_rules": {
        "angle_rules": [
          { "joint_a": "shoulder", "joint_b": "hip", "joint_c": "knee", "min_angle": 150, "max_angle": 200, "error_flag": "hips_sagging" }
        ],
        "alignment_rules": [],
        "relative_rules": [
          { "joint": "hip", "reference": "knee", "operator": ">=", "offset": -0.05, "axis": "y", "error_flag": "hips_not_elevated" }
        ]
      },
      "expected_accuracy": 0.86,
      "flags": {
        "hips_not_elevated": "Hips not elevated. Push through heels",
        "hips_sagging": "Hips sagging. Engage glutes more",
        "lower_back_arched": "Lower back arching. Keep neutral",
        "knees_caving": "Knees caving. Keep knees aligned"
      }
    },
    {
      "id": 5,
      "name": "Dead Hang",
      "description": "Hanging from bar with arms extended",
      "camera_angle": "front",
      "target_angle_range": 160,
      "primary_joints": ["wrist", "elbow", "shoulder"],
      "rules": {
        "both_arms_extended": true,
        "arm_angle_threshold": 160,
        "wrists_above_shoulders": true,
        "shoulders_engaged": true,
        "body_straight": true
      },
      "expected_accuracy": 0.89,
      "flags": {
        "elbows_bent": "Elbows bent. Keep arms straight > 160°",
        "wrists_below_shoulders": "Wrists below shoulders. Extend fully",
        "shoulder_shrugged": "Shoulders shrugged. Engage lats",
        "body_swinging": "Body swinging. Keep still"
      }
    },
